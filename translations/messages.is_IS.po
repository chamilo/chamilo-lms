msgstr "Verkefnastjóri"

msgid "Select classes for which this course will be visible for subscription in the catalogue. Subscription rules still apply apart from it being visible in the catalogue."
msgstr "Veldu bekkir þar sem þetta námskeið verður sýnilegt fyrir skráningu í námskrá. Skráningarreglur gilda enn, auk þess að vera sýnilegt í námskránni."

msgid "Remove the checkbox to enable sending announcements to users with HR roles (still requires to confirm in the announcements tool)."
msgstr "Fjarlægðu hakið til að leyfa sendingu tilkynninga til notenda með HR-hlutverkum (þarf samt staðfestingu í tilkynningatækinu)."

msgid "Sets which user appears as the sender of agenda reminder emails."
msgstr "Stillir hvaða notandi birtist sem sendandi áminningarpósta dagskrár."

msgid "Enable Multi-Level Attendance Grading"
msgstr "Virkja fjölþrepa mætingareinkunnagjöf"

