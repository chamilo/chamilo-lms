{% extends '@ChamiloCore/Layout/no_layout.html.twig' %}

{% block content %}
    {% set mapping_url = path('chamilo_core_ai_course_skill_mapping', {courseId: course.id}) %}
    {% set analyzer_url = path('chamilo_core_ai_course_analyzer', {courseId: course.id}) %}
    {% if session %}
        {% set mapping_url = mapping_url ~ '?sid=' ~ session.id %}
        {% set analyzer_url = analyzer_url ~ '?sid=' ~ session.id %}
    {% endif %}

    <main class="min-h-screen bg-gray-15 px-4 py-8 text-gray-90 md:px-8">
        <div class="mx-auto max-w-[1120px] space-y-6">
            <section class="rounded-2xl border border-gray-25 bg-white p-6 shadow-xl shadow-gray-90/5">
                <a href="{{ analyzer_url }}" class="text-primary hover:underline">{{ 'Back to AI course analyzer'|trans }}</a>
                <h1 class="mt-3 text-3xl font-bold">{{ 'AI-assisted skills mapping'|trans }}</h1>
                <p class="mt-2 text-gray-60">{{ course.title }}</p>
                <p class="mt-3 text-sm text-gray-60">
                    {{ 'Review all suggestions before adding skills. AI suggestions never change the referential automatically.'|trans }}
                </p>
                <p class="mt-2 text-sm text-warning-dark">
                    {{ 'Course content and existing skills may be sent to an external AI provider. Only continue if sharing is authorized.'|trans }}
                </p>
                {% if session %}
                    <p class="mt-2 text-sm text-gray-60">{{ 'The selected session is used for analysis. Approved skills are attached to the main course Gradebook.'|trans }}</p>
                {% endif %}
            </section>

            {% if error %}
                <div class="rounded-xl border-s-4 border-danger bg-danger/10 p-4 text-danger-dark" role="alert">{{ error|trans }}</div>
            {% endif %}
            {% if success %}
                <div class="rounded-xl border-s-4 border-success bg-success/10 p-4 text-success-dark" role="status">{{ success }}</div>
            {% endif %}

            <section class="rounded-2xl border border-gray-25 bg-white p-6 shadow-xl shadow-gray-90/5">
                {% if not enabled %}
                    <p>{{ 'AI course analyzer is disabled for this course.'|trans }}</p>
                {% elseif providers is empty %}
                    <p>{{ 'No AI text provider is configured.'|trans }}</p>
                {% else %}
                    <form method="post" action="{{ mapping_url }}" id="ai-skills-suggest-form" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
                        <input type="hidden" name="action" value="suggest">
                        <label for="provider" class="block font-semibold">{{ 'AI provider'|trans }}</label>
                        <select id="provider" name="provider" class="w-full rounded-xl border border-gray-30 bg-white p-3">
                            {% for provider in providers %}
                                <option value="{{ provider }}" {{ provider == selected_provider ? 'selected' : '' }}>{{ provider }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" id="ai-skills-suggest" class="rounded-xl bg-primary px-5 py-3 font-bold text-white">
                            {{ 'Suggest skills for this course'|trans }}
                        </button>
                        <p id="ai-skills-loading" class="hidden text-sm text-gray-60" role="status">{{ 'Analyzing course, please wait…'|trans }}</p>
                    </form>
                {% endif %}
            </section>

            {% if suggestions is not empty %}
                <section class="rounded-2xl border border-gray-25 bg-white p-6 shadow-xl shadow-gray-90/5">
                    <h2 class="mb-3 text-xl font-semibold">{{ 'Review suggested skills'|trans }}</h2>
                    {% if not can_attach %}
                        <p class="mb-4 text-warning-dark">{{ 'You can review suggestions, but you do not have permission to assign skills to Gradebook.'|trans }}</p>
                    {% endif %}
                    <form method="post" action="{{ mapping_url }}" id="ai-skills-approve-form">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
                        <input type="hidden" name="action" value="approve">
                        <input type="hidden" name="nonce" value="{{ nonce }}">
                        <div class="space-y-3">
                            {% for suggestion in suggestions %}
                                {% set cannot_approve = not can_attach or (suggestion.kind == 'new' and not can_create) %}
                                <label for="skill_{{ loop.index0 }}" class="flex cursor-pointer gap-4 rounded-xl border border-gray-25 p-4">
                                    <input type="checkbox" id="skill_{{ loop.index0 }}" name="selected[]" value="{{ loop.index0 }}" class="mt-1" {% if cannot_approve %}disabled{% endif %}>
                                    <span class="flex-1">
                                        <strong class="block">{{ suggestion.title }}</strong>
                                        <span class="mt-1 block text-sm font-medium text-primary">
                                            {% if suggestion.kind == 'existing' %}
                                                {{ 'Existing skill'|trans }} #{{ suggestion.skillId }}
                                            {% else %}
                                                {{ 'New skill'|trans }} · {{ 'Parent skill'|trans }}: {{ suggestion.parentTitle }} (#{{ suggestion.parentId }})
                                            {% endif %}
                                        </span>
                                        {% if suggestion.description %}<span class="mt-1 block text-sm">{{ suggestion.description }}</span>{% endif %}
                                        {% if suggestion.criteria|default('') %}<span class="mt-1 block text-sm">{{ 'Criteria'|trans }}: {{ suggestion.criteria }}</span>{% endif %}
                                        {% if suggestion.reason %}<span class="mt-1 block text-sm text-gray-60">{{ 'Reason'|trans }}: {{ suggestion.reason }}</span>{% endif %}
                                        {% if suggestion.kind == 'new' and not can_create %}
                                            <span class="mt-1 block text-sm text-warning-dark">{{ 'Only a platform administrator can create new skills.'|trans }}</span>
                                        {% endif %}
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                        {% if can_attach %}
                            <button type="submit" id="ai-skills-approve" class="mt-5 rounded-xl bg-primary px-5 py-3 font-bold text-white">
                                {{ 'Add selected skills to referential and Gradebook'|trans }}
                            </button>
                        {% endif %}
                    </form>
                </section>
            {% endif %}
        </div>
    </main>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('ai-skills-suggest-form')
        const button = document.getElementById('ai-skills-suggest')
        const loading = document.getElementById('ai-skills-loading')
        if (form && button && loading) {
          form.addEventListener('submit', function () {
            button.disabled = true
            button.setAttribute('aria-busy', 'true')
            loading.classList.remove('hidden')
          })
        }
      })
    </script>
{% endblock %}
