msgid "Shibboleth authentication"
msgstr "Shibbolethi autentimine"

msgid "<p>First of all, you have to configure Shibboleth for your web server.</p>To configure it for Chamilo<h5>edit file main/auth/shibboleth/config/aai.class.php</h5><p>Modify object &#36;result values with the name of your Shibboleth attributes</p><ul><li>&#36;result-&gt;unique_id = 'mail';</li><li>&#36;result-&gt;firstname = 'cn';</li><li>&#36;result-&gt;lastname = 'uid';</li><li>&#36;result-&gt;email = 'mail';</li><li>&#36;result-&gt;language = '-';</li><li>&#36;result-&gt;gender = '-';</li><li>&#36;result-&gt;address = '-';</li><li>&#36;result-&gt;staff_category = '-';</li><li>&#36;result-&gt;home_organization_type = '-'; </li><li>&#36;result-&gt;home_organization = '-';</li><li>&#36;result-&gt;affiliation = '-';</li><li>&#36;result-&gt;persistent_id = '-';</li><li>...</li></ul><br/>Go to <a href='settings.php?category=Shibboleth'>Plugin</a> to add a configurable 'Shibboleth Login' button for your Chamilo campus."
msgstr "<p>Esmalt peate konfigureerima Shibbolethi oma veebiserveri jaoks.</p>Chamilo jaoks konfigureerimiseks<h5>muutke faili main/auth/shibboleth/config/aai.class.php</h5><p>Muutke objekti &#36;result väärtusi vastavalt oma Shibbolethi atribuutide nimedele</p><ul><li>&#36;result-&gt;unique_id = 'mail';</li><li>&#36;result-&gt;firstname = 'cn';</li><li>&#36;result-&gt;lastname = 'uid';</li><li>&#36;result-&gt;email = 'mail';</li><li>&#36;result-&gt;language = '-';</li><li>&#36;result-&gt;gender = '-';</li><li>&#36;result-&gt;address = '-';</li><li>&#36;result-&gt;staff_category = '-';</li><li>&#36;result-&gt;home_organization_type = '-'; </li><li>&#36;result-&gt;home_organization = '-';</li><li>&#36;result-&gt;affiliation = '-';</li><li>&#36;result-&gt;persistent_id = '-';</li><li>...</li></ul><br/>Mine <a href='settings.php?category=Shibboleth'>Lisamoodul</a> juurde, et lisada konfigureeritav 'Shibbolethi sisselogimise' nupp oma Chamilo platvormile."

msgid "LDAP authentication"
msgstr "LDAP autentimine"

msgid "Facebook authentication"
msgstr "Facebooki autentimine"

msgid "<p><h5>Create your Facebook Application</h5>First of all, you have to create a Facebook Application (see <a href='https://developers.facebook.com/apps'>https://developers.facebook.com/apps</a>) with your Facebook account. In the Facebook Apps settings, the site URL value should be the URL of this campus. Enable the Web OAuth Login option. And add the site URL of your campus to the Valid OAuth redirect URIs field</p><p>Uncomment the line <code>&#36;_configuration['facebook_auth'] = 1;</code> to enable the Facebook Auth.</p><p>Then, edit the <code>app/config/auth.conf.php</code> file and enter '<code>appId</code>' and '<code>secret</code>' values for <code>&#36;facebook_config</code>.</p><p>Go to <a href='settings.php?category=Plugins'>Plugins</a> to add a configurable <em>Facebook Login</em> button for your Chamilo campus.</p>"
msgstr "<p><h5>Looge oma Facebooki rakendus</h5>Esmalt peate looma Facebooki rakenduse (vt <a href='https://developers.facebook.com/apps'>https://developers.facebook.com/apps</a>) oma Facebooki kontoga. Facebooki rakenduste seadetes peab saidi URL olema selle platvormi URL. Lubage Web OAuth Login valik. Lisage oma platvormi saidi URL kehtivate OAuth-i ümbersuunamise URI-de väljale</p><p>Tühistage kommentaar realt <code>&#36;_configuration['facebook_auth'] = 1;</code>, et lubada Facebooki autentimine.</p><p>Seejärel muutke faili <code>app/config/auth.conf.php</code> ja sisestage '<code>appId</code>' ja '<code>secret</code>' väärtused <code>&#36;facebook_config</code> jaoks.</p><p>Minge <a href='settings.php?category=Plugins'>Lisamoodulid</a> juurde, et lisada konfigureeritav <em>Facebooki sisselogimise</em> nupp oma Chamilo platvormile.</p>"

