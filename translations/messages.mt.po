msgstr "Qasam miżjud b'suċċess"

msgid "Grades thresholds colouring"
msgstr "Kulur tal-limiti tal-gradi"

msgid "Tick the box to enable marks thresholds"
msgstr "Immarka l-kaxxa biex tattiva l-limiti tal-marki"

msgid "Enable marks thresholds"
msgstr "Attiva l-limiti tal-marki"

msgid "Competence levels labelling"
msgstr "Eżempji tal-livelli ta' kompetenza"

msgid "Tick the box to enable Competence levels labelling"
msgstr "Immarka l-kaxxa biex tattiva l-eżempji tal-livelli ta' kompetenza"

msgid "Enable Competence level labelling"
msgstr "Attiva l-eżempji tal-livelli ta' kompetenza"

msgid "Threshold"
msgstr "Limitu"

msgid "The threshold (in %) under which scores will be colored red"
msgstr "Il-limitu (f'%) li taħtu l-punteġġi jkunu miżbugħin aħmar"

msgid "Display score upper limit"
msgstr "Uri l-limitu superjuri tal-punteġġ"

