msgstr "Núverandi meðlimir"

msgid "Add members"
msgstr "Bæta við meðlimum"

msgid "Search for users in course/session..."
msgstr "Leita að notendum í námskeiði/kennslutímabili..."

msgid "No users available."
msgstr "Engir notendur tiltækir."

msgid "Browse and publish new posts"
msgstr "Skoða og birta nýjar færslur"

msgid "Create and assign tasks"
msgstr "Búa til og úthluta verkefnum"

msgid "Filtered by %s"
msgstr "Síað eftir %s"

msgid "Select a score"
msgstr "Veldu einkunn"

msgid "Edit comment"
msgstr "Breyta athugasemd"

msgid "Failed to update the post."
msgstr "Ekki tókst að uppfæra færsluna."

msgid "Delete this post? This action cannot be undone."
msgstr "Eyða þessari færslu? Ekki er hægt að afturkalla aðgerðina."

