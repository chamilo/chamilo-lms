msgstr "Ekki tókst að eyða færslunni."

msgid "Failed to update the comment."
msgstr "Ekki tókst að uppfæra athugasemdina."

msgid "Delete this comment?"
msgstr "Eyða þessari athugasemd?"

msgid "Failed to delete the comment."
msgstr "Ekki tókst að eyða athugasemdinni."

msgid "Search for projects..."
msgstr "Leita að verkefnum..."

