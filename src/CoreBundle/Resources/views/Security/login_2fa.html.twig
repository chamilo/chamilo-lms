{% extends "@ChamiloCore/Layout/layout_one_col.html.twig" %}

{% block content %}
    <section id="login-2fa" class="py-8">
        <div class="mx-auto w-full max-w-md">
            <form method="post" action="{{ path('login_2fa') }}" class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
                <h2 class="text-2xl font-semibold text-center mb-6">{{ "Enter 2FA code"|trans }}</h2>

                {% if error %}
                    <div class="alert alert-danger mb-4" role="alert">{{ error }}</div>
                {% endif %}

                <div class="mb-4">
                    <label for="login-2fa-totp" class="block text-gray-700 text-sm font-bold mb-2">
                        {{ "Enter your 2FA code"|trans }}
                    </label>
                    <input type="text"
                           id="login-2fa-totp"
                           name="totp"
                           class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           pattern="[0-9]*"
                           maxlength="10"
                           required
                           autofocus>
                </div>

                <input type="hidden" name="_token" value="{{ csrf_token('login_2fa') }}">
                <button type="submit" class="btn btn--primary w-full">
                    {{ "Verify"|trans }}
                </button>
            </form>
        </div>
    </section>
{% endblock %}
