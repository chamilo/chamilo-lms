{% extends '@ChamiloCore/Layout/layout_one_col.html.twig' %}

{% block content %}
    <div class="flex gap-4">
        <div class="w-1/5">
            {% include '@ChamiloCore/Admin/Settings/menu.html.twig' %}
        </div>
        <div class="w-4/5">
            <h1 class="text-2xl font-semibold mb-3">{{ 'Course settings'|trans }}</h1>
            <p class="mb-4">{{ 'Control which course settings can be changed by teachers and their platform defaults.'|trans }}</p>
            <form method="get" action="{{ path('chamilo_course_settings_policies') }}" class="mb-4 flex items-center gap-2">
                <label for="course_setting_search">{{ 'Search'|trans }}</label>
                <input type="search" id="course_setting_search" name="q" value="{{ search }}"
                       maxlength="120" class="flex-1 border border-gray-300 rounded px-2 py-1"
                       placeholder="{{ 'Search'|trans }}">
                <button type="submit" class="btn btn-primary">{{ 'Search'|trans }}</button>
                {% if search %}
                    <a href="{{ path('chamilo_course_settings_policies') }}" class="btn btn-default">{{ 'Reset'|trans }}</a>
                {% endif %}
            </form>
            <p class="text-sm text-gray-600 mb-3">{{ definitions|length }} / {{ total_count }}</p>
            {% if ambiguous_count > 0 %}
                <p class="text-sm text-gray-600 mb-3">
                    {{ 'Settings with shared names are listed separately by category. Blank categories in old course records are not separate settings.'|trans }}
                </p>
            {% endif %}
            <form method="post" action="{{ path('chamilo_course_settings_policies', {'q': search}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('course_settings_policies') }}">
                <div class="overflow-x-auto bg-white rounded-lg shadow-sm">
                    <table class="w-full border-collapse">
                        <thead>
                            <tr class="bg-gray-50 text-left">
                                <th class="p-3">{{ 'Course setting'|trans }}</th>
                                <th class="p-3">{{ 'Editable in course'|trans }}</th>
                                <th class="p-3">{{ 'Default platform value'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for variable, originalDefault in definitions %}
                                {% set policy = policies[variable] ?? null %}
                                <tr class="border-t border-gray-200">
                                    <td class="p-3">
                                        <label for="default_{{ variable }}" class="font-medium">
                                            {{ variable|replace({'.': ' / ', '_': ' '})|capitalize }}
                                        </label>
                                        <div class="text-xs text-gray-500">{{ variable }}</div>
                                    </td>
                                    <td class="p-3">
                                        <input type="checkbox"
                                               name="editable[{{ variable }}]"
                                               value="1"
                                               aria-label="{{ 'Editable in course'|trans }}: {{ variable }}"
                                               {% if policy is null or policy.editable %}checked{% endif %}>
                                    </td>
                                    <td class="p-3">
                                        {% set currentValue = policy is not null ? policy.default : originalDefault %}
                                        {% if allowed_values[variable] is defined %}
                                            <select id="default_{{ variable }}" name="defaults[{{ variable }}]"
                                                    class="w-full border border-gray-300 rounded px-2 py-1">
                                                {% for option in allowed_values[variable] %}
                                                    <option value="{{ option }}" {% if currentValue == option %}selected{% endif %}>
                                                        {% if option == '' %}
                                                            {{ 'Use platform fallback'|trans }}
                                                        {% elseif allowed_values[variable]|length == 2 and '0' in allowed_values[variable] and '1' in allowed_values[variable] %}
                                                            {{ option == '1' ? 'Yes'|trans : 'No'|trans }}
                                                        {% elseif option == 'true' or option == 'false' %}
                                                            {{ option == 'true' ? 'Yes'|trans : 'No'|trans }}
                                                        {% else %}
                                                            {{ option }}
                                                        {% endif %}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        {% else %}
                                            <input id="default_{{ variable }}"
                                                   name="defaults[{{ variable }}]"
                                                   type="text"
                                                   maxlength="2048"
                                                   class="w-full border border-gray-300 rounded px-2 py-1"
                                                   value="{{ currentValue }}">
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="flex justify-end mt-4">
                    <button type="submit" name="save_course_settings_policy" class="btn btn-primary" {% if definitions is empty %}disabled{% endif %}>
                        {{ 'Save settings'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
