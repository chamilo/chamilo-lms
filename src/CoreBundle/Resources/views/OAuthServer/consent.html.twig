{% extends "@ChamiloCore/Layout/layout_one_col.html.twig" %}

{% block content %}
    <div class="mx-auto max-w-lg space-y-6">
        <div class="rounded-2xl border border-gray-25 bg-white p-6 shadow-sm">
            <h1 class="m-0 text-2xl font-semibold text-gray-90">
                {{ 'Authorize application'|trans }}
            </h1>

            <p class="mt-4 text-body-2 text-gray-90">
                <strong>{{ client.clientName|default('An application') }}</strong>
                {{ 'wants to connect to your Chamilo account.'|trans }}
            </p>

            <div class="mt-4 rounded-xl border border-gray-25 bg-gray-10 p-4">
                <p class="text-body-2 text-gray-50">
                    {{ 'Signed in as'|trans }}
                </p>
                <p class="font-semibold text-gray-90">
                    {{ oauth_user.fullName|default(oauth_user.username) }} ({{ oauth_user.username }})
                </p>
            </div>

            <div class="mt-4 rounded-xl border border-gray-25 bg-gray-10 p-4">
                <p class="font-semibold text-gray-90">
                    {{ 'Application trust information'|trans }}
                </p>

                <p class="mt-2 text-body-2 text-gray-50">
                    {% if client_registration_age_days == 0 %}
                        {{ 'This application was registered today.'|trans }}
                    {% elseif client_registration_age_days == 1 %}
                        {{ 'This application was registered 1 day ago.'|trans }}
                    {% else %}
                        {{ 'This application was registered %days% days ago.'|trans({'%days%': client_registration_age_days}) }}
                    {% endif %}
                </p>

                <p class="mt-2 text-body-2 text-gray-50">
                    {% if first_granted_at %}
                        {{ 'You first approved this application on %date%.'|trans({'%date%': first_granted_at|date('Y-m-d')}) }}
                    {% else %}
                        {{ 'No previous approval is recorded for this application.'|trans }}
                    {% endif %}
                </p>
            </div>

            <p class="mt-4 text-body-2 text-gray-50">
                {{ 'This application will be able to act on Chamilo exactly as you can — using your existing account permissions and nothing more. It will never gain any access you do not already have.'|trans }}
            </p>

            <form method="post" class="mt-6 flex gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token }}">

                <button
                        type="submit"
                        name="action"
                        value="allow"
                        class="rounded-xl bg-primary px-4 py-2 font-semibold text-white hover:opacity-90"
                >
                    {{ 'Allow'|trans }}
                </button>

                <button
                        type="submit"
                        name="action"
                        value="deny"
                        class="rounded-xl border border-gray-25 bg-white px-4 py-2 font-semibold text-gray-90 hover:bg-gray-10"
                >
                    {{ 'Deny'|trans }}
                </button>
            </form>
        </div>
    </div>
{% endblock %}
