msgstr "Aðeins sýnilegt"

msgid "Rename project"
msgstr "Endurnefna verkefni"

msgid "New title"
msgstr "Nýtt heiti"

msgid "You need to be a admin or teacher to manage projects."
msgstr "Þú verður að vera stjórnandi eða kennari til að stýra verkefnum."

msgid "Delete this project? This action cannot be undone."
msgstr "Eyða þessu verkefni? Ekki er hægt að afturkalla aðgerðina."

msgid "Task list"
msgstr "Verkefnalisti"

msgid "Change status"
msgstr "Breyta stöðu"

