{% extends '@ChamiloCore/Layout/layout_one_col.html.twig' %}

{% block content %}
    <style>
        @media (max-width: 1023px) {
            .ch-course-policies-layout {
                flex-direction: column;
            }

            .ch-course-policies-navigation,
            .ch-course-policies-main {
                width: 100%;
            }

            .ch-course-policies-navigation {
                max-height: 16rem;
                overflow-y: auto;
            }

            .ch-course-policies-main > .px-4 {
                padding-left: 0;
                padding-right: 0;
            }
        }
    </style>
    <div class="flex gap-4 ch-course-policies-layout">
        <div class="w-1/5 ch-course-policies-navigation">
            {% include '@ChamiloCore/Admin/Settings/menu.html.twig' %}
        </div>
        <div class="w-4/5 min-w-0 ch-course-policies-main">
            <div class="px-4">
                <div class="mb-6">
                    <h1 class="text-gray-90 text-h6 font-semibold tracking-wide">{{ 'Course settings'|trans }}</h1>
                    <p class="mt-2 text-gray-80 text-body-2">
                        {{ 'Control which course settings can be changed by teachers and their platform defaults.'|trans }}
                    </p>
                </div>

                <div class="mb-6">
                    <form method="get" action="{{ path('chamilo_course_settings_policies') }}" class="w-full">
                        <div class="mb-4">
                            <label for="course_setting_search" class="block mb-2 text-gray-90 text-body-2 font-semibold">{{ 'Search'|trans }}</label>
                            <input type="search" id="course_setting_search" name="q" value="{{ search }}"
                                   maxlength="120" class="w-full border border-gray-300 rounded px-3 py-2"
                                   placeholder="{{ 'Search'|trans }}">
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <button type="submit" class="inline-flex items-center justify-center rounded-md border border-primary bg-primary px-4 py-2 font-semibold text-white">{{ 'Search'|trans }}</button>
                            {% if search %}
                                <a href="{{ path('chamilo_course_settings_policies') }}" class="btn btn-default">{{ 'Reset'|trans }}</a>
                            {% endif %}
                        </div>
                    </form>
                </div>

                <div class="mb-6 pb-3 border-b border-gray-25">
                    <p class="text-gray-60 text-body-2">{{ definitions|length }} / {{ total_count }}</p>
                    {% if ambiguous_count > 0 %}
                        <p class="mt-2 text-gray-60 text-body-2">
                            {{ 'Settings with shared names are listed separately by category. Blank categories in old course records are not separate settings.'|trans }}
                        </p>
                    {% endif %}
                </div>

                <form method="post" action="{{ path('chamilo_course_settings_policies', {'q': search}) }}" class="w-full">
                    <input type="hidden" name="_token" value="{{ csrf_token('course_settings_policies') }}">
                    {% for variable, originalDefault in definitions %}
                        {% set policy = policies[variable] ?? null %}
                        {% set currentValue = policy is not null ? policy.default : originalDefault %}
                        <div class="mb-6 rounded-lg bg-white shadow-lg">
                            <div class="flex justify-between items-start border-s-8 border-primary rounded-s-lg rounded-se-lg bg-support-2 px-4 py-4 -ms-2 text-body-2">
                                <div class="min-w-0">
                                    <h3 class="text-gray-90 text-body-1 font-semibold">
                                        {{ variable|replace({'.': ' / ', '_': ' '})|capitalize }}
                                    </h3>
                                    <div class="mt-1 text-gray-60 text-body-2 break-all">{{ variable }}</div>
                                </div>
                            </div>
                            <div class="grid gap-5 p-4 border-t border-gray-25 md:grid-cols-2">
                                <div>
                                    <label for="editable_{{ variable }}" class="block mb-2 text-gray-80 text-body-2 font-semibold">
                                        {{ 'Editable in course'|trans }}
                                    </label>
                                    <input type="checkbox" id="editable_{{ variable }}"
                                           name="editable[{{ variable }}]"
                                           value="1"
                                           aria-label="{{ 'Editable in course'|trans }}: {{ variable }}"
                                           {% if policy is null or policy.editable %}checked{% endif %}>
                                </div>
                                <div class="min-w-0">
                                    <label for="default_{{ variable }}" class="block mb-2 text-gray-80 text-body-2 font-semibold">
                                        {{ 'Default platform value'|trans }}
                                    </label>
                                    {% if allowed_values[variable] is defined %}
                                        <select id="default_{{ variable }}" name="defaults[{{ variable }}]"
                                                class="w-full border border-gray-300 rounded px-3 py-2">
                                            {% for option in allowed_values[variable] %}
                                                <option value="{{ option }}" {% if currentValue == option %}selected{% endif %}>
                                                    {% if option == '' %}
                                                        {{ 'Use platform fallback'|trans }}
                                                    {% elseif allowed_values[variable]|length == 2 and '0' in allowed_values[variable] and '1' in allowed_values[variable] %}
                                                        {{ option == '1' ? 'Yes'|trans : 'No'|trans }}
                                                    {% elseif option == 'true' or option == 'false' %}
                                                        {{ option == 'true' ? 'Yes'|trans : 'No'|trans }}
                                                    {% else %}
                                                        {{ option }}
                                                    {% endif %}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    {% else %}
                                        <input id="default_{{ variable }}"
                                               name="defaults[{{ variable }}]"
                                               type="text"
                                               maxlength="2048"
                                               class="w-full border border-gray-300 rounded px-3 py-2"
                                               value="{{ currentValue }}">
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    <div class="flex justify-end mt-4 mb-6">
                        <button type="submit" name="save_course_settings_policy" class="btn btn-primary" {% if definitions is empty %}disabled{% endif %}>
                            {{ 'Save settings'|trans }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
