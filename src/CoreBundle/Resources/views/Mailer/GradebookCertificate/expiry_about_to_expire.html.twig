<div id="email-message" style="padding-top:10px; padding-bottom:10px;">
    <p>{{ 'Hello,'|trans }} {{ full_name }}</p>
    <p>{{ 'Your certificate is about to expire:'|trans }}</p>
    <div style="border-color: #faebcc; padding: 15px; background-color: #fcf8e3; margin-bottom: 15px; font-size: 16px; color:#8a6d3b;">
        <p>
            <strong>{{ 'Course'|trans }}: </strong>{{ course_title }}<br>
            <strong>{{ 'Certificate'|trans }}: </strong>{{ category_title }}<br>
            <strong>{{ 'Expiry date'|trans }}: </strong>{{ expiry_date }}
            ({{ '%s days remaining'|trans({'%s': days_until_expiry}) }})
        </p>
    </div>

    {% if certificate_url %}
        <p><a style="font-weight: bold; color: #2BA6CB;" href="{{ certificate_url }}">{{ 'Online link to certificate'|trans }}</a></p>
    {% endif %}
</div>
