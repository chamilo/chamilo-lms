msgstr "Skoða skírteini"

msgid "%d min"
msgstr "%d mín"

msgid "Duration in minutes"
msgstr "Tímalengd í mínútum"

msgid "Go back to standard view"
msgstr "Fara aftur í venjulega sýn"

