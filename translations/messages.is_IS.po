msgstr "Bíður staðfestingar"

msgid "Delete this task?"
msgstr "Eyða þessu verkefni?"

msgid "Failed to delete the task."
msgstr "Ekki tókst að eyða verkefninu."

msgid "Failed to update status."
msgstr "Ekki tókst að uppfæra stöðu."

msgid "Are you sure you want to delete this third party? This action cannot be undone."
msgstr "Ertu viss um að þú viljir eyða þessum þriðja aðila? Ekki er hægt að afturkalla aðgerðina."

msgid "Please fix the errors before saving."
msgstr "Vinsamlegast leiðréttu villurnar áður en þú vistar."

msgid "Error creating third party. Please verify the data."
msgstr "Villa við að búa til þriðja aðila. Vinsamlegast staðfestu gögnin."

msgid "Error deleting third party."
msgstr "Villa við að eyða þriðja aðila."

msgid "Upload optional header and email logos. SVG is preferred; PNG is used as fallback."
msgstr "Hlaða upp valfrjálsum haus- og tölvupóstmerkjum. SVG er æskilegt; PNG er notað sem varafall."

msgid "Data exchange updated successfully."
msgstr "Gagnaskipti uppfærð með góðum árangri."

msgid "Error deleting data exchange."
msgstr "Villa við að eyða gagnaskiptum."

