msgstr "Begrenser synlighet av online-brukere til spesifikke brukerroller."

msgid "Auto-provision more anonymous users"
msgstr "Automatisk opprettelse av flere anonyme brukere"

msgid "Dynamically creates new anonymous users to support high visitor traffic."
msgstr "Oppretter dynamisk nye anonyme brukere for å støtte høy besøkstrafikk."

msgid "Access to personal file for all"
msgstr "Tilgang til personlig fil for alle"

msgid "Allows all users to access, view, and manage their personal files within the system."
msgstr "Lar alle brukere få tilgang til, vise og administrere sine personlige filer i systemet."

msgid "Enable the copy of session-specific content to another session"
msgstr "Aktiver kopiering av sesjonsspesifikt innhold til en annen sesjon"

msgid "Allows duplication of resources that were created in the session when duplicating the session."
msgstr "Tillater duplisering av ressurser som ble opprettet i sesjonen ved duplisering av sesjonen."

msgid "Enable Automatic Reinscription"
msgstr "Aktiver automatisk reinnbetaling"

msgid "Enable or disable automatic re-subscription when course validity expires. The related cron job must also be activated."
msgstr "Aktiver eller deaktiver automatisk reinnbetaling når kursets gyldighet utløper. Den relaterte cron-jobben må også aktiveres."

msgid "Enable Session Replication"
msgstr "Aktiver sesjonsreplikering"

