msgstr "Kursforespørselen %s vil bli slettet. Er det greit å fortsette?"

msgid "Reject this course request"
msgstr "Avvis denne kursforespørselen"

msgid "The course request %s is going to be rejected. Is it OK to proceed?"
msgstr "Kursforespørselen %s vil bli avvist. Er det greit å fortsette?"

msgid "The course request %s has been accepted. A new course %s has been created."
msgstr "Kursforespørselen %s er godkjent. Et nytt kurs %s er opprettet."

