msgstr "Tək seçim düymələri"

msgid "Select drop-down"
msgstr "Açılan seçim siyahısı"

msgid "Multiple selection drop-down"
msgstr "Çoxseçimli açılan siyahı"

msgid "Field successfully added"
msgstr "Sahə uğurla əlavə edildi"

msgid "Grades thresholds colouring"
msgstr "Qiymət hədlərinin rənglənməsi"

msgid "Tick the box to enable marks thresholds"
msgstr "Qiymət hədlərini aktivləşdirmək üçün xananı işarələ"

msgid "Enable marks thresholds"
msgstr "Qiymət hədlərini aktivləşdir"

msgid "Competence levels labelling"
msgstr "Bacarıq səviyyələrinin etiketlənməsi"

