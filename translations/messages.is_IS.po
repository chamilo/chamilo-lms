msgstr "Leita að nemanda..."

msgid "This date is locked or read-only."
msgstr "Þessi dagsetning er læst eða skrifvarin."

msgid "Failed to load attendance. Please try again later."
msgstr "Ekki tókst að hlaða mætingu. Reyndu aftur síðar."

msgid "Nothing to save"
msgstr "Ekkert til að vista"

msgid "You have unsaved changes. Leave anyway?"
msgstr "Þú ert með óvistaðar breytingar. Yfirgefa samt?"

msgid "Storage usage unavailable"
msgstr "Gagnageymsla ekki tiltæk"

msgid "Search for members..."
msgstr "Leita að meðlimum..."

